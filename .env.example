# AI Vulnerability Exposure Analyzer settings
# Copy this file to .env to change a setting. Never commit .env.
# API keys don't go here: enter them in the app under API Keys Configuration. They're kept for your
# browser session only, and the app never reads keys from .env, the environment or Streamlit secrets.

# Optional: override the Cohere model (default: command-a-plus-05-2026,
# automatically falls back to command-a-03-2025 if your key cannot use it)
# COHERE_MODEL=command-a-plus-05-2026
