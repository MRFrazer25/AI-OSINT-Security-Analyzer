# AI OSINT Security Analyzer configuration
# Copy this file to .env and fill in your keys. Never commit .env.
# Keys can also be entered in the web UI (kept in your browser session only).

# Required: drives the AI agent. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional: override the Cohere model (default: command-a-plus-05-2026,
# automatically falls back to command-a-03-2025 if your key cannot use it)
# COHERE_MODEL=command-a-plus-05-2026

# Exposed services and banners. https://account.shodan.io/
SHODAN_API_KEY=

# Reputation from security engines. https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# IP abuse reports. https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Optional: raises NVD rate limits from 5 to 50 requests per 30s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: more GreyNoise lookups than the 10 a day allowed without a key (needs a business email).
# https://viz.greynoise.io/signup
GREYNOISE_API_KEY=

# Keys above stay on the server. Visitors do not use them unless you set this to true.
# SHARE_SERVER_KEYS=false
# Analyses that use the server's keys (not a visitor's own) are capped process-wide:
# SERVER_KEY_RUNS_PER_HOUR=20
# SERVER_KEY_RUNS_PER_CLIENT_PER_HOUR=5
# Set either limit to 0 to switch off analyses that use the server's keys.
# The per-visitor limit uses the connecting address. If the app runs behind proxies you control, set this to
# how many there are so the visitor's address is read from X-Forwarded-For (otherwise that header is ignored):
# TRUSTED_PROXY_HOPS=0

# CISA KEV, FIRST EPSS, OSV.dev, Spamhaus DROP, the internet registries and certificate logs need no keys.
# Without SHODAN_API_KEY, Shodan's free InternetDB is used instead (ports and software, no banners).
