# AI OSINT Security Analyzer configuration
# Copy this file to .env and fill in your keys. Never commit .env.
# Keys can also be entered in the web UI (kept in your browser session only).

# Required: drives the AI agent. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional: override the Cohere model (default: command-a-plus-05-2026,
# automatically falls back to command-a-03-2025 if your key cannot use it)
# COHERE_MODEL=command-a-plus-05-2026

# Exposed services and banners. https://account.shodan.io/
SHODAN_API_KEY=

# Reputation from security engines. https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# IP abuse reports. https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Optional: raises NVD rate limits from 5 to 50 requests per 30s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# CISA KEV and FIRST EPSS need no keys.
